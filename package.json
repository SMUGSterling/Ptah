{
  "name": "ptah",
  "productName": "Ptah",
  "version": "0.1.0",
  "description": "3D level blockout editor for game design. Exports USD for Unity and Unreal.",
  "main": "main.js",
  "author": "SMU Guildhall Academic Technology",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "web": "node test/serve.mjs",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node test/usd.test.mjs",
    "test:browser": "node test/e2e.browser.mjs",
    "test:smoke": "electron test/smoke.js",
    "test:smoke:headless": "xvfb-run -a electron --no-sandbox test/smoke.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "playwright": "^1.56.0"
  },
  "build": {
    "appId": "edu.smu.guildhall.ptah",
    "productName": "Ptah",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": { "target": ["nsis", "portable"] },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.developer-tools" },
    "linux": { "target": ["AppImage", "deb"], "category": "Development" }
  }
}
