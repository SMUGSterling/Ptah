{
  "name": "ptah",
  "productName": "Ptah",
  "version": "0.1.0",
  "description": "3D level blockout editor for game design. Exports USD for Unity and Unreal.",
  "main": "main.js",
  "author": "SMU Guildhall Academic Technology",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "edu.smu.guildhall.ptah",
    "productName": "Ptah",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": { "target": ["nsis", "portable"] },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.developer-tools" },
    "linux": { "target": ["AppImage", "deb"], "category": "Development" }
  }
}
